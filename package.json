{
  "name": "cefr-speaking-bot",
  "version": "1.0.0",
  "description": "Multilevel (CEFR) speaking mock \u2014 Telegram Mini App (React + Ionic) on Telegram Serverless, with OpenAI + Deepgram assessment",
  "scripts": {
    "dev": "node scripts/build-env.mjs --if-missing && vite",
    "dev:api": "node scripts/build-env.mjs --if-missing && node --no-warnings --import ./dev/register.mjs dev/server.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node scripts/build-env.mjs --if-missing && node --no-warnings --import ./dev/register.mjs --import ./test/setup-env.mjs --test test/*.test.mjs",
    "deploy": "node scripts/build-env.mjs --strict && npm run build && tgcloud push",
    "migrate": "tgcloud migrate",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "env": "node scripts/build-env.mjs --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edumoschool/cefr_speakingBot.git"
  },
  "dependencies": {
    "@ionic/react": "^8.8.19",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
