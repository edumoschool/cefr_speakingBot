# Copy to .env and fill in. `npm run deploy` ships these with the bot
# (as tgcloud/lib/env.js, which is git-ignored). Never commit .env.

# --- AI services ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# Speech-to-text: "deepgram" or "elevenlabs". If both keys are set, the other
# one is used automatically when the main one fails.
TRANSCRIBER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2

# --- Telegram ---
CHANNEL_ID=@your_channel              # students must join it; the bot must be an admin there
CHANNEL_URL=https://t.me/your_channel
ADMIN_IDS=123456789                   # your Telegram user id (comma-separate several)
SUPPORT_CONTACT=@your_support_username

# Mini App link printed by `npm run deploy` (https://app<id>.tgcloud.ai/).
# Leave empty for the very first deploy, then fill it in and deploy again.
APP_URL=
