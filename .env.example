# --- Telegram ---
BOT_TOKEN=123456:ABC...            # from @BotFather
BOT_USERNAME=MultilevelSpeakingBot # without @
CHANNEL_ID=@your_channel           # channel users must join (@username or -100... id). The bot MUST be an admin there.
CHANNEL_URL=https://t.me/your_channel
WEBHOOK_SECRET=change-me-random-string   # sent by Telegram in X-Telegram-Bot-Api-Secret-Token
ADMIN_IDS=11111111,22222222        # Telegram user ids allowed to use /stats and /grant
ADMIN_SECRET=change-me-too         # protects GET /api/admin/setup

# --- Public URL of this deployment (Mini App URL) ---
APP_URL=https://your-project.vercel.app

# --- Database (Neon Postgres recommended; any Postgres URL works) ---
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- AI providers ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini          # any chat model that supports json_schema structured outputs
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-3

# --- Business rules ---
FREE_ATTEMPTS=1                    # free mocks for every new user
REFERRALS_PER_ATTEMPT=3            # qualified referrals needed for +1 attempt
